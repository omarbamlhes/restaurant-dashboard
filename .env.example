# ───────────────────────────────────────────────────────────
# Database — PostgreSQL connection string
# Use a strong password in production
# ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/restaurant_dashboard?schema=public"

# ───────────────────────────────────────────────────────────
# Redis — for caching / sessions (optional in dev)
# ───────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ───────────────────────────────────────────────────────────
# JWT — REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Never commit a real secret.
# ───────────────────────────────────────────────────────────
JWT_SECRET="REPLACE_WITH_RANDOM_64_BYTE_HEX"
JWT_EXPIRES_IN="7d"

# ───────────────────────────────────────────────────────────
# OpenAI (Phase 2 — AI features)
# ───────────────────────────────────────────────────────────
OPENAI_API_KEY=""

# ───────────────────────────────────────────────────────────
# Stripe (optional — international payments)
# ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ───────────────────────────────────────────────────────────
# Moyasar Payment Gateway (Saudi Arabia)
# Dashboard: https://dashboard.moyasar.com
# ───────────────────────────────────────────────────────────
MOYASAR_SECRET_KEY="sk_test_YOUR_KEY_HERE"
MOYASAR_PUBLISHABLE_KEY="pk_test_YOUR_KEY_HERE"
MOYASAR_CALLBACK_URL="http://localhost:3000/settings/billing/callback"

# ───────────────────────────────────────────────────────────
# App configuration
# FRONTEND_URL accepts comma-separated origins for multi-domain CORS
# e.g. "https://app.example.com,https://admin.example.com"
# ───────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"

# ───────────────────────────────────────────────────────────
# Error tracking — Sentry (recommended for production)
# Get a DSN from https://sentry.io after creating a project
# Server-side (API + Next.js server):
# SENTRY_DSN=""
# Client-side (Next.js browser bundle, must be NEXT_PUBLIC_):
# NEXT_PUBLIC_SENTRY_DSN=""
