generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH & USERS ============

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  password          String
  name              String
  phone             String?
  role              UserRole       @default(OWNER)
  permissions       String[]       @default([])
  language          String         @default("ar")
  restaurantId      String?
  managedRestaurant Restaurant?    @relation("staff", fields: [restaurantId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  restaurant        Restaurant?    @relation("owner")
  notifications     Notification[]
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
  ADMIN
}

// ============ RESTAURANT ============

model Restaurant {
  id           String         @id @default(cuid())
  name         String
  nameAr       String
  logo         String?
  phone        String?
  email        String?
  taxNumber    String?
  currency     String         @default("SAR")
  timezone     String         @default("Asia/Riyadh")
  ownerId      String         @unique
  owner        User           @relation("owner", fields: [ownerId], references: [id])
  staff        User[]         @relation("staff")
  subscription Subscription?
  branches     Branch[]
  menuItems    MenuItem[]
  categories      Category[]
  kitchenStations KitchenStation[]
  ingredients     Ingredient[]
  customers       Customer[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ============ SUBSCRIPTION & BILLING ============

model Subscription {
  id                 String             @id @default(cuid())
  restaurantId       String             @unique
  restaurant         Restaurant         @relation(fields: [restaurantId], references: [id])
  plan               PlanType           @default(BASIC)
  status             SubStatus          @default(ACTIVE)
  billingCycle       BillingCycle       @default(MONTHLY)
  paymentGateway     PaymentGatewayType?
  gatewayCustomerId  String?
  gatewaySubId       String?
  trialEndsAt        DateTime?
  canceledAt         DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  invoices           Invoice[]
  paymentMethods     SubPaymentMethod[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

enum PlanType {
  BASIC
  PRO
  ENTERPRISE
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PaymentGatewayType {
  MOYASAR
  TAP
  STRIPE
}

// ============ INVOICES ============

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  subscriptionId  String
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  tax             Decimal       @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  status          InvoiceStatus @default(UNPAID)
  paidAt          DateTime?
  pdfUrl          String?
  periodStart     DateTime
  periodEnd       DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([subscriptionId, createdAt])
}

enum InvoiceStatus {
  DRAFT
  PAID
  UNPAID
  OVERDUE
  REFUNDED
}

// ============ PAYMENT METHODS ============

model SubPaymentMethod {
  id              String       @id @default(cuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
  type            CardType
  last4           String
  expiry          String
  isDefault       Boolean      @default(false)
  gatewayTokenId  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([subscriptionId])
}

enum CardType {
  MADA
  VISA
  MASTERCARD
  APPLE_PAY
}

// ============ BRANCHES ============

model Branch {
  id            String         @id @default(cuid())
  name          String
  nameAr        String
  address       String?
  city          String?
  latitude      Float?
  longitude     Float?
  isMain        Boolean        @default(false)
  restaurantId  String
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id])
  orders        Order[]
  employees     Employee[]
  inventoryLogs InventoryLog[]
  tables        Table[]
  reservations  Reservation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ============ KITCHEN STATIONS ============

model KitchenStation {
  id           String     @id @default(cuid())
  name         String
  nameAr       String
  color        String     @default("#6366f1")
  sortOrder    Int        @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  menuItems    MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ============ MENU ============

model Category {
  id           String     @id @default(cuid())
  name         String
  nameAr       String
  sortOrder    Int        @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  menuItems    MenuItem[]
}

model MenuItem {
  id              String               @id @default(cuid())
  name            String
  nameAr          String
  description     String?
  descriptionAr   String?
  image           String?
  price           Decimal              @db.Decimal(10, 2)
  cost            Decimal?             @db.Decimal(10, 2)
  isActive        Boolean              @default(true)
  preparationTime Int?
  categoryId      String
  category        Category             @relation(fields: [categoryId], references: [id])
  stationId       String?
  station         KitchenStation?      @relation(fields: [stationId], references: [id])
  restaurantId    String
  restaurant      Restaurant           @relation(fields: [restaurantId], references: [id])
  ingredients     MenuItemIngredient[]
  orderItems      OrderItem[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([restaurantId, isActive])
  @@index([categoryId])
}

model Ingredient {
  id            String               @id @default(cuid())
  name          String
  nameAr        String
  unit          String
  costPerUnit   Decimal              @db.Decimal(10, 2)
  currentStock  Decimal              @db.Decimal(10, 2) @default(0)
  minStock      Decimal              @db.Decimal(10, 2) @default(0)
  restaurantId  String
  restaurant    Restaurant           @relation(fields: [restaurantId], references: [id])
  menuItems     MenuItemIngredient[]
  inventoryLogs InventoryLog[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model MenuItemIngredient {
  id           String     @id @default(cuid())
  menuItemId   String
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id])
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Decimal    @db.Decimal(10, 4)

  @@unique([menuItemId, ingredientId])
}

// ============ TABLES ============

model Table {
  id           String      @id @default(cuid())
  number       Int
  name         String?
  nameAr       String?
  capacity     Int         @default(4)
  status       TableStatus @default(AVAILABLE)
  branchId     String
  branch       Branch        @relation(fields: [branchId], references: [id])
  orders       Order[]
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([branchId, number])
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

// ============ RESERVATIONS ============

model Reservation {
  id           String            @id @default(cuid())
  tableId      String
  table        Table             @relation(fields: [tableId], references: [id])
  branchId     String
  branch       Branch            @relation(fields: [branchId], references: [id])
  customerId   String?
  customer     Customer?         @relation(fields: [customerId], references: [id])
  customerName String
  customerPhone String
  partySize    Int
  date         DateTime          @db.Date
  time         String            // "14:30"
  endTime      String?           // "16:00"
  status       ReservationStatus @default(PENDING)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([branchId, date])
  @@index([tableId, date])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ============ CUSTOMERS ============

model Customer {
  id             String       @id @default(cuid())
  name           String
  phone          String
  email          String?
  notes          String?
  totalOrders    Int          @default(0)
  totalSpent     Decimal      @db.Decimal(12, 2) @default(0)
  lastOrderAt    DateTime?
  loyaltyPoints  Int          @default(0) // current redeemable balance
  lifetimePoints Int          @default(0) // total ever earned — drives tier, never decreases
  restaurantId   String
  restaurant     Restaurant   @relation(fields: [restaurantId], references: [id])
  orders         Order[]
  reservations   Reservation[]
  loyaltyTxns    LoyaltyTransaction[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([restaurantId, phone])
  @@index([restaurantId])
}

enum LoyaltyTxnType {
  EARN
  REDEEM
  ADJUST
}

model LoyaltyTransaction {
  id           String         @id @default(cuid())
  customerId   String
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId      String?
  type         LoyaltyTxnType
  points       Int            // positive = earn, negative = redeem/deduct
  balanceAfter Int            // running balance after this txn
  note         String?
  createdAt    DateTime       @default(now())

  @@index([customerId])
}

// ============ ORDERS ============

model Order {
  id             String         @id @default(cuid())
  orderNumber    String
  type           OrderType
  status         OrderStatus    @default(PENDING)
  subtotal       Decimal        @db.Decimal(10, 2)
  tax            Decimal        @db.Decimal(10, 2) @default(0)
  discount       Decimal        @db.Decimal(10, 2) @default(0)
  total          Decimal        @db.Decimal(10, 2)
  paymentMethod  PaymentMethod  @default(CASH)
  paymentStatus  PaymentStatus  @default(PAID)
  paidAmount     Decimal        @db.Decimal(10, 2) @default(0)
  cashAmount     Decimal        @db.Decimal(10, 2) @default(0)
  cardAmount     Decimal        @db.Decimal(10, 2) @default(0)
  changeAmount   Decimal        @db.Decimal(10, 2) @default(0)
  branchId       String
  branch         Branch         @relation(fields: [branchId], references: [id])
  tableId        String?
  table          Table?         @relation(fields: [tableId], references: [id])
  deliverySource DeliverySource? // platform a DELIVERY order came through
  customerId     String?
  customer       Customer?      @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  posOrderId     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([branchId, createdAt])
  @@index([createdAt])
}

enum PaymentMethod {
  CASH
  CARD
  MADA
  STC_PAY
  APPLE_PAY
  TABBY
  TAMARA
  SPLIT
}

enum PaymentStatus {
  PAID
  UNPAID
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum DeliverySource {
  IN_HOUSE
  JAHEZ
  HUNGERSTATION
  TOYOU
  KEETA
  MRSOOL
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

model OrderItem {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  menuItemId    String
  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id])
  quantity      Int
  unitPrice     Decimal       @db.Decimal(10, 2)
  totalPrice    Decimal       @db.Decimal(10, 2)
  notes         String?
  stationStatus StationStatus @default(PENDING)

  @@index([orderId])
  @@index([menuItemId])
}

enum StationStatus {
  PENDING
  PREPARING
  DONE
}

// ============ INVENTORY ============

model InventoryLog {
  id           String          @id @default(cuid())
  ingredientId String
  ingredient   Ingredient      @relation(fields: [ingredientId], references: [id])
  branchId     String
  branch       Branch          @relation(fields: [branchId], references: [id])
  type         InventoryAction
  quantity     Decimal         @db.Decimal(10, 2)
  note         String?
  createdAt    DateTime        @default(now())
}

enum InventoryAction {
  PURCHASE
  CONSUMED
  WASTED
  ADJUSTMENT
  TRANSFER
}

// ============ EMPLOYEES ============

model Employee {
  id        String   @id @default(cuid())
  name      String
  nameAr    String
  phone     String?
  role      String
  salary    Decimal? @db.Decimal(10, 2)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  shifts    Shift[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shift {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id])
  startTime     DateTime
  endTime       DateTime?
  ordersHandled Int       @default(0)
  notes         String?
}

// ============ AI & ANALYTICS ============

model AIPrediction {
  id           String         @id @default(cuid())
  restaurantId String
  type         PredictionType
  date         DateTime
  data         Json
  accuracy     Float?
  createdAt    DateTime       @default(now())
}

enum PredictionType {
  DAILY_SALES
  WEEKLY_SALES
  MENU_OPTIMIZATION
  WASTE_ALERT
  DEMAND_FORECAST
}

model DailySummary {
  id           String   @id @default(cuid())
  restaurantId String
  branchId     String?
  date         DateTime @db.Date
  totalOrders  Int
  totalRevenue Decimal  @db.Decimal(12, 2)
  totalCost    Decimal  @db.Decimal(12, 2)
  totalProfit  Decimal  @db.Decimal(12, 2)
  topItems     Json
  wasteAmount  Decimal? @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  @@unique([restaurantId, branchId, date])
  @@index([restaurantId, date])
}

// ============ NOTIFICATIONS ============

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  title     String
  titleAr   String
  message   String
  messageAr String
  type      NotificationType
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
}

enum NotificationType {
  LOW_STOCK
  HIGH_WASTE
  SALES_ALERT
  DAILY_REPORT
  AI_RECOMMENDATION
  PAYMENT_DUE
  SYSTEM
}

// ============ OUTBOUND CUSTOMER MESSAGING ============
// Every WhatsApp/SMS message we attempt to send is recorded here so staff can
// see delivery status and so the flow is verifiable in dev with the mock driver.
model MessageLog {
  id           String        @id @default(cuid())
  restaurantId String
  channel      MessageChannel @default(WHATSAPP)
  event        String        // ORDER_READY | RESERVATION_CONFIRMED
  toPhone      String        // E.164
  body         String
  status       MessageStatus @default(PENDING)
  provider     String        @default("mock")
  providerId   String?       // provider-side message id, when available
  error        String?
  orderId      String?
  reservationId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([restaurantId, createdAt])
  @@index([status])
}

enum MessageChannel {
  WHATSAPP
  SMS
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}
